{
  "name": "marksix-intelligence",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy --name marksix-research-v3",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:deployment": "node --test tests/cloudflare-deployment.test.mjs",
    "test": "npm run typecheck && npm run test:ai && npm run test:research && npm run build && npm run test:deployment && node --test tests/rendered-html.test.mjs",
    "test:ai": "node --test tests/ai-engine.test.ts tests/ai-online-learning.test.ts tests/ai-ledger.test.ts tests/lottery-data.test.ts tests/research-v2.test.ts tests/research-v2-random.test.ts tests/research-consensus.test.ts tests/research-review.test.ts tests/research-v3.test.ts tests/research-v3-store.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:research": "PYTHONPATH=research/src python3 -m unittest discover -s research/tests -v",
    "research:shadow": "PYTHONPATH=research/src python3 -m marksix_research.cli run",
    "data:sync": "node scripts/sync-lottery-history.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
